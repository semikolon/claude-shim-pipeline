#!/usr/bin/env bash
#
# Claude Dispatcher - Shim-based architecture
# Called by shim: ~/bin/claude-dispatcher "claude" [args...]
#
# Provides consistent execution path: shim → dispatcher → wrapper → real binary
# Supports --ccr flag to enable CCR wrapper (default: native Claude + Serena only)

set -euo pipefail

# Debug logging (set CLAUDE_DEBUG=1 to enable)
if [[ "${CLAUDE_DEBUG:-0}" == "1" ]]; then
    DEBUG_LOG="/tmp/claude-shims-debug.log"
    exec 3>> "$DEBUG_LOG"
    echo "=== DISPATCHER START $(date '+%H:%M:%S.%N') ===" >&3
    echo "Args: $*" >&3
    echo "CLAUDE_PIPELINE_STAGE: ${CLAUDE_PIPELINE_STAGE:-unset}" >&3
    set -x
    BASH_XTRACEFD=3
fi

# First argument is the command name from the shim
CMD_NAME="$1"
shift

# Configuration
WRAPPER_BASE_DIR="$HOME/.config/claude/wrappers.d"
WRAPPER_ORDER=("ccr" "graphiti")  # ccr first, then graphiti (serena disabled 2025-12-21 due to persistent stability issues)

# Check for custom flags and remove them from arguments
ARGS=()
USE_CCR=false
USE_SAFE_MODE=false

for arg in "$@"; do
    if [[ "$arg" == "--ccr" ]]; then
        USE_CCR=true
    elif [[ "$arg" == "--safe" ]]; then
        USE_SAFE_MODE=true
    else
        ARGS+=("$arg")
    fi
done

# Default to YOLO mode (--dangerously-skip-permissions) unless --safe is passed
# Safety-net plugin provides protection against truly destructive commands
if [[ "$USE_SAFE_MODE" != "true" ]]; then
    ARGS+=("--dangerously-skip-permissions")
fi

# Local Ruby LSP plugin (bypasses broken marketplace plugin structure + exec() stdin race)
if [[ -d "$HOME/.claude-plugin" ]]; then
    ARGS+=("--plugin-dir" "$HOME/.claude-plugin")
fi

# Find the real claude binary (excluding shims and wrappers)
# Create a clean PATH without our managed directories
CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v -E "(claude/shims|claude/wrappers)" | tr '\n' ':' | sed 's/:$//')
REAL_CLAUDE=$(PATH="$CLEAN_PATH" command -v claude)

if [[ -z "$REAL_CLAUDE" ]]; then
    echo "❌ DISPATCHER: Error: Real claude binary not found in system PATH" >&2
    exit 1
fi

# Export real claude location for wrappers to use directly
export CLAUDE_REAL_BINARY="$REAL_CLAUDE"

# Export dispatcher path and command for wrapper re-dispatch
export CLAUDE_DISPATCHER="$HOME/.config/claude/libexec/claude-dispatcher" 
export CLAUDE_CMD_NAME="$CMD_NAME"

# Build list of active shims (for display only)
ACTIVE_SHIMS=()
# Shim descriptions (4-5 words max)
declare -A SHIM_DESCRIPTIONS=(
    ["graphiti"]="global and per-project memory"
)
if [[ "$USE_CCR" == "true" ]]; then
    # In CCR mode, check all available wrappers
    for wrapper in "${WRAPPER_ORDER[@]}"; do
        if [[ -x "$WRAPPER_BASE_DIR/$wrapper/$CMD_NAME" ]]; then
            desc="${SHIM_DESCRIPTIONS[$wrapper]:-}"
            if [[ -n "$desc" ]]; then
                ACTIVE_SHIMS+=("$wrapper ($desc)")
            else
                ACTIVE_SHIMS+=("$wrapper")
            fi
        fi
    done
else
    # In default mode, all wrappers except CCR are enabled
    # CCR is silently skipped - not shown in output
    for wrapper in "${WRAPPER_ORDER[@]}"; do
        if [[ "$wrapper" == "ccr" ]]; then
            continue  # Skip CCR entirely in output
        fi
        if [[ -x "$WRAPPER_BASE_DIR/$wrapper/$CMD_NAME" ]]; then
            desc="${SHIM_DESCRIPTIONS[$wrapper]:-}"
            if [[ -n "$desc" ]]; then
                ACTIVE_SHIMS+=("$wrapper ($desc)")
            else
                ACTIVE_SHIMS+=("$wrapper")
            fi
        fi
    done
fi

# Display the clean summary line (only on initial call, not recursive pipeline stages)
PIPELINE_STAGE="${CLAUDE_PIPELINE_STAGE:-0}"
if [[ "$PIPELINE_STAGE" -eq 0 ]]; then
    # Check daemon health (super concise)
    DAEMON_STATUS=""
    # TTS daemon: check launchctl (PID in first column = running)
    tts_info=$(launchctl list 2>/dev/null | grep "tts-daemon" || echo "- -")
    tts_pid=$(echo "$tts_info" | awk '{print $1}')
    if [[ "$tts_pid" != "-" && "$tts_pid" =~ ^[0-9]+$ ]]; then
        DAEMON_STATUS+="T✓"
    else
        DAEMON_STATUS+="T✗"
    fi
    # Graphiti daemon
    if pgrep -f "graphiti_mcp_server" > /dev/null 2>&1; then
        DAEMON_STATUS+="G✓"
    else
        DAEMON_STATUS+="G✗"
    fi

    # Build status components
    STATUS_PARTS=()

    # YOLO mode indicator
    if [[ "$USE_SAFE_MODE" != "true" ]]; then
        STATUS_PARTS+=("🔓 YOLO mode")
    else
        STATUS_PARTS+=("🔒 safe mode")
    fi

    # Active shims
    if [[ ${#ACTIVE_SHIMS[@]} -gt 0 ]]; then
        shim_list=$(IFS=', '; echo "${ACTIVE_SHIMS[*]}")
        STATUS_PARTS+=("SHIMS: $shim_list")
    fi

    # Display combined status with middle dot separator
    # Join array elements with ' · ' (IFS only uses first char, so build manually)
    status_line=""
    for i in "${!STATUS_PARTS[@]}"; do
        if [[ $i -gt 0 ]]; then
            status_line+=" · "
        fi
        status_line+="${STATUS_PARTS[$i]}"
    done
    echo "✨ Claude Code: $status_line · $DAEMON_STATUS" >&2
fi

# Find the first available wrapper based on mode and order
WRAPPER_TO_USE=""

if [[ "$USE_CCR" == "true" ]]; then
    # In CCR mode, use full pipeline
    # Check if we're still within the wrapper pipeline
    if (( PIPELINE_STAGE < ${#WRAPPER_ORDER[@]} )); then
        # Get current wrapper name from array (generic!)
        WRAPPER_NAME="${WRAPPER_ORDER[PIPELINE_STAGE]}"
        WRAPPER_PATH="$WRAPPER_BASE_DIR/$WRAPPER_NAME/$CMD_NAME"
        
        if [[ -x "$WRAPPER_PATH" ]]; then
            # Execute wrapper with incremented stage for next iteration
            export CLAUDE_PIPELINE_STAGE=$((PIPELINE_STAGE + 1))
            WRAPPER_TO_USE="$WRAPPER_PATH"
        else
            # Skip missing wrapper by incrementing stage and re-dispatching
            export CLAUDE_PIPELINE_STAGE=$((PIPELINE_STAGE + 1))
            exec "$0" "$CMD_NAME" "${ARGS[@]}"
        fi
    else
        # End of pipeline - all wrappers have run, use real Claude
        WRAPPER_TO_USE=""
    fi
else
    # In default mode, use pipeline but skip CCR
    # Check if we're still within the wrapper pipeline
    if (( PIPELINE_STAGE < ${#WRAPPER_ORDER[@]} )); then
        # Get current wrapper name from array
        WRAPPER_NAME="${WRAPPER_ORDER[PIPELINE_STAGE]}"
        WRAPPER_PATH="$WRAPPER_BASE_DIR/$WRAPPER_NAME/$CMD_NAME"

        if [[ "$WRAPPER_NAME" == "ccr" ]]; then
            # Skip CCR in default mode by incrementing stage and re-dispatching
            export CLAUDE_PIPELINE_STAGE=$((PIPELINE_STAGE + 1))
            exec "$0" "$CMD_NAME" "${ARGS[@]}"
        elif [[ -x "$WRAPPER_PATH" ]]; then
            # Execute non-CCR wrapper with incremented stage for next iteration
            export CLAUDE_PIPELINE_STAGE=$((PIPELINE_STAGE + 1))
            WRAPPER_TO_USE="$WRAPPER_PATH"
        else
            # Skip missing wrapper by incrementing stage and re-dispatching
            export CLAUDE_PIPELINE_STAGE=$((PIPELINE_STAGE + 1))
            exec "$0" "$CMD_NAME" "${ARGS[@]}"
        fi
    else
        # End of pipeline - all wrappers have run, use real Claude
        WRAPPER_TO_USE=""
    fi
fi

# Execute the chosen wrapper or fall back to real binary
if [[ -n "$WRAPPER_TO_USE" ]]; then
    [[ "${CLAUDE_DEBUG:-0}" == "1" ]] && echo "DISPATCHER: exec wrapper $WRAPPER_TO_USE" >&3
    exec "$WRAPPER_TO_USE" "${ARGS[@]}"
else
    [[ "${CLAUDE_DEBUG:-0}" == "1" ]] && echo "DISPATCHER: exec real claude $REAL_CLAUDE" >&3
    exec "$REAL_CLAUDE" "${ARGS[@]}"
fi