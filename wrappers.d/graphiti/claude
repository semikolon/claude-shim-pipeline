#!/bin/bash
# Graphiti wrapper - Sets per-session GROUP_ID for knowledge graph isolation
# Part of composable Claude Code wrapper ecosystem
#
# ARCHITECTURE (Mar 2026):
#   - Stdio transport: Per-session Graphiti subprocesses
#   - Shared DB: launchd-managed local FalkorDB singleton
#   - GROUP_ID: Derived from git project for knowledge isolation
#
# WHAT THIS WRAPPER DOES:
#   1. Computes GRAPHITI_GROUP_ID from git project (or "default" for global scope)
#   2. Re-dispatches to continue wrapper pipeline
#   3. Leaves DB mode to the Graphiti launcher + mcp_server/.env
#
# HISTORY:
#   - Pre-Jan 2026: Docker container + SSE transport + refcounting
#   - Jan 16, 2026: FalkorDBLite eliminated Docker dependency
#   - Jan 22, 2026: Simplified wrapper, removed dead Docker/SSE code

set -euo pipefail

# Debug logging (inherits CLAUDE_DEBUG from dispatcher)
if [[ "${CLAUDE_DEBUG:-0}" == "1" ]]; then
    DEBUG_LOG="/tmp/claude-shims-debug.log"
    exec 3>> "$DEBUG_LOG"
    echo "=== GRAPHITI WRAPPER START $(date '+%H:%M:%S.%N') ===" >&3
    echo "PWD: $PWD" >&3
    set -x
    BASH_XTRACEFD=3
fi

# Check for global scope override flag
if [[ "${1:-}" == "--global-scope" ]] || [[ "${1:-}" == "--global" ]]; then
    # Use "default" as the global scope identifier
    export GRAPHITI_GROUP_ID="default"
    # Remove the flag from arguments before passing to next claude
    shift
else
    # Normal project-aware behavior
    # Find git root, fall back to PWD for project detection
    project_root=$(git -C "${PWD}" rev-parse --show-toplevel 2>/dev/null || echo "${PWD}")

    # Create human-readable, safe GROUP_ID from project name
    # Converts "My-Project_Name" -> "my-project-name"
    name=$(basename "$project_root")
    export GRAPHITI_GROUP_ID=$(printf %s "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
fi

[[ "${CLAUDE_DEBUG:-0}" == "1" ]] && echo "GRAPHITI: GROUP_ID=${GRAPHITI_GROUP_ID}" >&3

# Re-dispatch to continue pipeline unless we're in standalone mode
if [[ -n "${CLAUDE_DISPATCHER:-}" ]] && [[ -n "${CLAUDE_CMD_NAME:-}" ]]; then
    # Pipeline mode - re-dispatch to continue through remaining stages
    [[ "${CLAUDE_DEBUG:-0}" == "1" ]] && echo "GRAPHITI: re-dispatching to ${CLAUDE_DISPATCHER}" >&3
    exec "${CLAUDE_DISPATCHER}" "${CLAUDE_CMD_NAME}" "$@"
else
    # Standalone mode - find next claude in PATH
    [[ "${CLAUDE_DEBUG:-0}" == "1" ]] && echo "GRAPHITI: standalone mode, finding next claude" >&3
    this_dir=$(dirname "$0")
    filtered_path=$(echo "${PATH}" | tr ':' '\n' | grep -Fxv "${this_dir}" | paste -sd: -)

    if [[ -z "${filtered_path}" ]]; then
        echo "❌ GRAPHITI: Could not filter PATH (broken wrapper chain)" >&2
        exit 127
    fi

    next_claude=$(PATH="${filtered_path}" command -v claude)
    if [[ -z "${next_claude}" ]]; then
        echo "❌ GRAPHITI: Could not find next 'claude' executable in chain" >&2
        exit 127
    fi

    [[ "${CLAUDE_DEBUG:-0}" == "1" ]] && echo "GRAPHITI: exec next claude $next_claude" >&3
    exec "${next_claude}" "$@"
fi
